{
  "expo": {
    "name": "GAIA",
    "slug": "gaia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gaia",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#00ff88",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.darkmoor.gaia",
      "supportsTablet": true
    },
    "android": {
      "package": "com.darkmoor.gaia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "GAIA uses the camera to diagnose crop diseases."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GAIA reads your photos to analyze crops."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "$rootDir/../node_modules/expo-camera/android/maven"
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "48d7bb48-df02-4d67-b566-793649a2d0a6"
      }
    },
    "owner": "darkmoorai"
  }
}