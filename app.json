{
  "expo": {
    "name": "GAIA",
    "slug": "gaia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gaia",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#00ff88",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.darkmoor.gaia",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "GAIA uses your camera to diagnose crop diseases.",
        "NSPhotoLibraryUsageDescription": "GAIA accesses your photos to analyze crops.",
        "NSLocationWhenInUseUsageDescription": "GAIA uses location for weather-based advice.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GAIA tracks your farm perimeter."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBKmMMLYYSD6b-i3RGzufqykv6WtnEyY4w"
      }
    },
    "android": {
      "package": "com.darkmoor.gaia",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBKmMMLYYSD6b-i3RGzufqykv6WtnEyY4w"
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "GAIA needs camera access."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GAIA needs photo access."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GAIA tracks your farm perimeter."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "48d7bb48-df02-4d67-b566-793649a2d0a6"
      }
    },
    "owner": "darkmoorai",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/48d7bb48-df02-4d67-b566-793649a2d0a6"
    }
  }
}
