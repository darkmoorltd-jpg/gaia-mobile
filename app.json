{
  "expo": {
    "name": "GAIA",
    "slug": "gaia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gaia",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#00ff88",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.darkmoor.gaia",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "GAIA uses your camera to diagnose crop diseases.",
        "NSPhotoLibraryUsageDescription": "GAIA accesses your photos to analyze crops.",
        "NSLocationWhenInUseUsageDescription": "GAIA uses location for weather-based advice.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GAIA tracks your farm perimeter."
      }
    },
    "android": {
      "package": "com.darkmoor.gaia",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "GAIA needs camera access."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GAIA needs photo access."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GAIA tracks your farm perimeter."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
